#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    macros {
        swap_up: swap_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&mkp MB5 &msc SCRL_UP>;
            label = "SWAP_UP";
        };

        swap_down: swap_down {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&mkp MB5 &msc SCRL_DOWN>;
            label = "SWAP_DOWN";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC   |  1  |  2  |  3   |  4   |  5   |                    |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB   |  Q  |  W  |  E   |  R   |  T   |                    |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL  |  A  |  S  |  D   |  F   |  G   |                    |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT  |  Z  |  X  |  C   |  V   |  B   |                    |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            // |    2   |  2  | f   | 6    | 4    | 1    |                    | 2    | 1     | w     | s    | n     |  a    |

            bindings = <
&kp F1            &kp F2  &kp F3  &kp F4        &kp F5     &kp F6              &kp F7           &kp F8     &kp F9      &kp F10  &kp F11   &kp F12
&kp GRAVE         &kp N1  &kp N2  &kp N3        &kp N4     &kp N5              &kp N6           &kp N7     &kp N8      &kp N9   &kp N0    &kp EQUAL
&kp TAB           &kp Q   &kp W   &kp E         &kp R      &kp T               &kp Y            &kp U      &kp I       &kp O    &kp P     &kp MINUS
&kp ESCAPE        &kp A   &kp S   &kp D         &kp F      &kp G               &kp H            &kp J      &kp K       &kp L    &kp SEMI  &kp SQT
&kp LEFT_CONTROL  &kp Z   &kp X   &kp C         &kp V      &kp B               &kp N            &kp M      &kp COMMA   &kp DOT  &kp FSLH  &kp BSLH
                                  &kp LEFT_ALT  &kp ENTER  &kp LEFT_SHIFT      &kp BACKSPACE    &kp SPACE  &kp DELETE
                                  &kp LEFT_WIN  &mo 5      &kp LEFT_CONTROL    &kp RIGHT_SHIFT  &mo 4      &kp RCTRL
            >;
        };

        FPS_Gaming {
            bindings = <
&kp ESCAPE  &kp F2     &kp F3  &kp F4        &kp F5     &kp F6    &kp F7             &kp F8     &kp F9         &kp F10  &kp F11   &kp F12
&kp GRAVE   &kp N1     &kp N2  &kp N3        &kp N4     &kp N5    &kp N6             &kp N7     &kp N8         &kp N9   &kp N0    &kp MINUS
&kp T       &kp TAB    &kp Q   &kp W         &kp E      &kp R     &kp Y              &kp U      &kp I          &kp O    &kp P     &kp EQUAL
&kp G       &kp LSHFT  &kp A   &kp S         &kp D      &kp F     &kp H              &kp J      &kp K          &kp L    &kp SEMI  &kp SQT
&kp Z       &kp LCTRL  &kp X   &kp C         &kp V      &kp B     &kp N              &kp M      &kp COMMA      &kp DOT  &kp FSLH  &kp BSLH
                               &kp LEFT_ALT  &kp SPACE  &kp N7    &trans             &kp ENTER  &kp RIGHT_ALT
                               &kp N0        &kp N9     &kp N8    &kp RIGHT_CONTROL  &mo 4      &none
            >;

            label = "WASD Shifted";
        };

        sc2 {
            label = "Non-WASD Shifted";
            bindings = <
&kp ESCAPE  &kp F2  &kp F3  &kp F4  &kp F5     &kp F6              &kp F7             &kp F8     &kp F9         &kp F10  &kp F11   &kp F12
&kp GRAVE   &kp N1  &kp N2  &kp N3  &kp N4     &kp N5              &kp N6             &kp N7     &kp N8         &kp N9   &kp N0    &kp MINUS
&kp TAB     &kp Q   &kp W   &kp E   &kp R      &kp T               &kp Y              &kp U      &kp I          &kp O    &kp P     &kp EQUAL
&kp N0      &kp A   &kp S   &kp D   &kp F      &kp G               &kp H              &kp J      &kp K          &kp L    &kp SEMI  &kp SQT
&kp N9      &kp Z   &kp X   &kp C   &kp V      &kp B               &kp N              &kp M      &kp COMMA      &kp DOT  &kp FSLH  &kp BSLH
                            &kp N8  &kp SPACE  &kp LEFT_SHIFT      &trans             &kp ENTER  &kp RIGHT_ALT
                            &kp N7  &kp N6     &kp LEFT_CONTROL    &kp RIGHT_CONTROL  &mo 4      &none
            >;
        };

        ArcRaiders {
            label = "WASD Shifted, Arc Raiders Macros";
            bindings = <
&kp ESCAPE  &kp F2     &kp F3  &kp F4        &kp F5     &kp F6        &kp F7             &kp F8     &kp F9         &kp F10  &kp F11   &kp F12
&kp GRAVE   &kp N1     &kp N2  &kp N3        &kp N4     &kp N5        &kp N6             &kp N7     &kp N8         &kp N9   &kp N0    &kp MINUS
&kp T       &kp TAB    &kp Q   &kp W         &kp E      &kp R         &kp Y              &kp U      &kp I          &kp O    &kp P     &kp EQUAL
&kp G       &kp LSHFT  &kp A   &kp S         &kp D      &kp F         &kp H              &kp J      &kp K          &kp L    &kp SEMI  &kp SQT
&kp Z       &kp LCTRL  &kp X   &kp C         &kp V      &kp B         &kp N              &kp M      &kp COMMA      &kp DOT  &kp FSLH  &kp BSLH
                               &kp LEFT_ALT  &kp SPACE  &swap_up      &trans             &kp ENTER  &kp RIGHT_ALT
                               &kp N0        &kp N9     &swap_down    &kp RIGHT_CONTROL  &mo 4      &none
            >;
        };

        Movement {
            bindings = <
&trans  &to 0           &to 1             &to 2         &trans        &trans    &kp C_PREVIOUS  &kp C_PLAY_PAUSE  &kp C_NEXT          &kp C_MUTE  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP
&trans  &trans          &trans            &trans        &trans        &trans    &trans          &trans            &trans              &trans      &trans             &trans
&trans  &trans          &trans            &trans        &trans        &trans    &trans          &trans            &trans              &trans      &trans             &trans
&trans  &kp LEFT_SHIFT  &kp LEFT_CONTROL  &kp LEFT_GUI  &kp LEFT_ALT  &trans    &kp LEFT        &kp DOWN          &kp UP_ARROW        &kp RIGHT   &trans             &trans
&trans  &trans          &trans            &trans        &trans        &trans    &kp HOME        &kp PAGE_DOWN     &kp PG_UP           &kp END     &trans             &trans
                                          &trans        &trans        &trans    &trans          &trans            &mo 6
                                          &trans        &trans        &trans    &trans          &trans            &kp K_CONTEXT_MENU
            >;

            label = "Arrows and function keys";
        };

        Symbols {
            bindings = <
&trans            &trans            &trans             &trans                &trans                 &trans       &trans  &trans        &trans        &trans           &trans        &trans
&trans            &trans            &trans             &trans                &trans                 &trans       &trans  &trans        &kp KP_SLASH  &kp KP_MULTIPLY  &kp KP_MINUS  &trans
&trans            &trans            &trans             &trans                &trans                 &trans       &trans  &kp NUMBER_7  &kp N8        &kp N9           &kp KP_PLUS   &trans
&kp CAPSLOCK      &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp EQUAL    &trans  &kp NUMBER_4  &kp N5        &kp NUMBER_6     &kp KP_PLUS   &trans
&kp LEFT_CONTROL  &kp LESS_THAN     &kp GREATER_THAN   &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp MINUS    &kp N0  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3     &kp DOT       &trans
                                                       &kp LEFT_ALT          &trans                 &trans       &trans  &trans        &kp INS
                                                       &kp K_CONTEXT_MENU    &trans                 &trans       &trans  &trans        &trans
            >;
        };

        meta_swap {
            bindings = <
&bt BT_CLR   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans  &trans  &trans  &trans  &trans  &trans
&trans       &trans        &trans        &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans  &trans
&trans       &trans        &trans        &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans  &trans
&trans       &trans        &trans        &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans  &trans
&bootloader  &trans        &trans        &trans        &trans        &trans          &to 0   &to 1   &to 2   &to 3   &trans  &bootloader
                                         &trans        &trans        &trans          &trans  &trans  &trans
                                         &trans        &trans        &trans          &trans  &trans  &trans
            >;
        };
    };
};
